{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "overrides": [
    {
      "files": ["packages/tui/src/yoga/**"],
      "rules": { "no-unused-vars": "off", "unicorn/no-new-array": "off" }
    },
    {
      "files": ["packages/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "bun", "bun:*"],
                "message": "@neant/shared must stay runtime-agnostic."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "Bun", "message": "@neant/shared must stay runtime-agnostic." },
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage"
        ]
      }
    }
  ]
}
