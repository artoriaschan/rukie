{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/coding-agent/src/ink/**",
    "scripts/release/launcher.cjs",
    ".agents/skills/**"
  ],
  "workspaces": {
    "packages/agent": {
      "entry": [
        "tests/helpers/session-store-worker.ts",
        "tests/helpers/goal-crash-worker.ts",
        "tests/helpers/subagent-recovery-worker.ts"
      ]
    },
    "packages/coding-agent": {
      "entry": ["src/ink/index.ts", "tests/fixtures/runtime-default-streams.tsx"]
    },
    ".scratch/pi-durable-migration/probe": {
      "entry": ["worker.ts"],
      "project": ["*.ts"],
      "ignoreDependencies": ["@earendil-works/pi-mcp"]
    },
    "packages/server": {
      "entry": ["tests/helpers/signal-server.ts", "src/main.ts"]
    }
  },
  "ignoreDependencies": ["supports-hyperlinks"]
}
