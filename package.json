{
  "name": "rukie",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun packages/coding-agent/src/main.ts",
    "release:build": "bun scripts/release/build.ts",
    "release:verify": "bun scripts/release/verify.ts",
    "release:accept": "bun scripts/release/accept.ts",
    "check:dev": "bun run docs:update && oxfmt --check && oxlint && tsc -b && knip && bun run check:scratch && bun run check:docs && bun run check:ink-boundaries && bun run check:test-policy && bun run check:ui-typography",
    "check:scratch": "bun scripts/check-scratch.ts",
    "check": "bun run check:dev && bun run test && bun run test:desktop",
    "test": "bun test --parallel=${RUKIE_TEST_WORKERS:-4}",
    "test:agent": "env -u NO_COLOR bun test --parallel=4 packages/agent/tests",
    "prepare": "husky",
    "test:coding-agent": "env -u NO_COLOR bun test --parallel=4 packages/coding-agent/tests",
    "check:docs": "bun scripts/check-docs.ts",
    "docs:update": "bun scripts/check-docs.ts --write",
    "test:docs": "bun test scripts/tests/check-docs.test.ts",
    "check:test-policy": "bun scripts/check-test-policy.ts",
    "check:ink-boundaries": "bun scripts/check-ink-boundaries.ts",
    "release:publish": "bun scripts/release/publication.ts",
    "test:desktop": "env -u NO_COLOR vitest run",
    "check:ui-typography": "bun scripts/check-ui-typography.ts",
    "desktop:build": "bun scripts/desktop/build.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electron/fuses": "2.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "electron-builder": "26.15.3",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "mdast-util-from-markdown": "2.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.64.0",
    "release-please": "17.3.0",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  }
}
