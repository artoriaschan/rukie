{
  "name": "neant",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "oxfmt --check && oxlint && tsc -b && knip && bun run test",
    "test": "bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  }
}
