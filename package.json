{
  "name": "neant",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run dev:tui",
    "dev:tui": "bun apps/neant-tui/src/main.tsx",
    "dev:cli": "bun apps/neant-cli/src/main.ts",
    "check:dev": "oxfmt --check && oxlint && tsc -b && knip",
    "check": "bun run check:dev && bun run test",
    "test": "bun test --parallel=4",
    "test:agent": "env -u NO_COLOR bun test --parallel=4 packages/agent/tests",
    "test:tui": "env -u NO_COLOR bun test --parallel=4 apps/neant-tui/tests packages/tui/tests",
    "test:cli": "env -u NO_COLOR bun test --parallel=4 apps/neant-cli/tests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  }
}
